    "^求解结果$",
    "^结果展示及说明$",
    "^结果展示$",
    "^实验结果与分析$",
    "^模型结果评估$",
    "^模型评估$"
   ]
  },
  {
   "role": "sub_check",
   "canonical": "模型检验",
   "level": 2,
   "patterns": [
    "^模型检验$",
    "^模型验证$",
    "^模型(的)?检验与分析$",
    "^有效性(检验|验证|分析)$",
    "^模型求解与检验$",
    "^消融实验$",
    "^对比实验$",
    "^泛化(能力)?(检验|分析)$"
   ]
  },
  {
   "role": "sub_summary",
   "canonical": "本章小结",
   "level": 2,
   "patterns": [
    "小结$",
    "^本章总结$",
    "^总结$"
   ]
  },
  {
   "role": "sensitivity",
   "canonical": "模型的灵敏度分析",
   "level": 1,
   "patterns": [
    "灵敏度",
    "敏感性",
    "稳健性",
    "鲁棒性",
    "^模型检验"
   ]
  },
  {
   "role": "evaluation",
   "canonical": "模型的评价与推广",
   "level": 1,
   "patterns": [
    "^模型(的)?评价",
    "^模型(的)?评估",
    "^模型评价与改进$",
    "^模型评价与推广$",
    "^模型(的)?优缺点",
    "^总结与评价$",
    "^模型总结$",
    "^总结与展望$",
    "^模型评估与展望$"
   ]
  },
  {
   "role": "strengths",
   "canonical": "模型的优点",
   "level": 2,
   "patterns": [
