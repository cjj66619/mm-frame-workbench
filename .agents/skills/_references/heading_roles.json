    "^模型基本假设$",
    "^假设$"
   ]
  },
  {
   "role": "notation",
   "canonical": "符号说明",
   "level": 1,
   "patterns": [
    "^符号说明$",
    "^符号与定义$",
    "^符号说明与名词解释$",
    "^变量说明$",
    "^名词解释$"
   ]
  },
  {
   "role": "assumptions_notation",
   "canonical": "模型假设与符号说明",
