{
 "_doc": "标题角色词典：role 是通用数模论文的章节功能；canonical 是语料中占比最高的规范写法；patterns 是识别该角色的正则（对去编号后的标题匹配）。手工维护，build_corpus.py 会在 FRAME_NORMS.md 里给出每个角色在语料中的实际变体与频次，据此增删 patterns。",
 "roles": [
  {
   "role": "abstract",
   "canonical": "摘要",
   "level": 1,
   "patterns": [
    "^摘\\s*要$"
   ],
   "strict_level": true
  },
  {
   "role": "restatement",
   "canonical": "问题重述",
   "level": 1,
   "patterns": [
    "问题重述",
    "问题背景与问题重述",
    "^问题背景与提出$",
    "^问题的提出与背景$"
   ]
  },
  {
   "role": "background",
   "canonical": "问题背景",
   "level": 2,
   "patterns": [
    "^问题背景$",
    "^研究背景",
    "^背景介绍$",
    "^问题的背景$"
   ]
  },
  {
   "role": "problem_posed",
   "canonical": "问题提出",
   "level": 2,
   "patterns": [
    "^问题提出$",
    "^问题的提出$",
    "^问题回顾$",
    "^问题解析$",
    "^需要解决的问题$",
    "^待解决的问题$",
    "^问题概述$",
    "^问题描述$"
   ]
  },
  {
   "role": "data_description",
   "canonical": "数据说明",
   "level": 2,
   "patterns": [
    "^数据说明$",
    "^数据介绍$",
    "^数据概述$",
    "^数据集概述$",
    "^数据来源$"
   ]
  },
  {
