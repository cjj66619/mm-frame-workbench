   "canonical": "问题分析",
   "level": 1,
   "patterns": [
    "^问题分析$",
    "^问题的分析$",
    "^问题分析与建模思路$",
    "^问题分析及建模思路$",
    "^总体分析$",
    "^总体思路$"
   ]
  },
  {
   "role": "roadmap",
   "canonical": "总体技术路线",
