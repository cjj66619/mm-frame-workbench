   ]
  },
  {
   "role": "sub_solve",
   "canonical": "模型求解",
   "level": 2,
   "patterns": [
    "^模型(的)?求解$",
    "^算法求解$",
    "^模型求解与分析$",
    "^模型求解和分析$",
    "^模型的求解及分析$",
    "^求解算法$",
    "^算法设计$",
    "^算法(设计)?与?实现$",
    "^模型训练$",
    "^模型训练与求解$"
   ]
  },
  {
   "role": "sub_results",
   "canonical": "结果分析",
   "level": 2,
   "patterns": [
    "^结果分析$",
    "^结果与分析$",
    "^求解结果与分析$",
    "^结果展示与分析$",
